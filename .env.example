# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PLAYLIST MANAGER FOR SPOTIFY
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite o arquivo .env ou credenciais no repositório.
# ==============================================================================

# Credenciais da API do Spotify (obtenha em: https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=seu_client_id_aqui
SPOTIPY_CLIENT_SECRET=seu_client_secret_aqui

# Redirect URI cadastrada de forma IDÊNTICA no Spotify Developer Dashboard
# Em desenvolvimento local: http://127.0.0.1:5000/callback
# Em produção (ex: Render): https://seu-app.onrender.com/callback
SPOTIPY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Segredo de sessão Flask (mínimo 32 bytes de alta entropia)
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=gerar_uma_chave_secreta_minimo_32_bytes_aqui

# Chave para criptografia em repouso dos tokens e cache (Fernet Base64)
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gerar_chave_fernet_base64_aqui

# Ambiente de execução: development ou production
FLASK_ENV=development

# Permitir bind em 0.0.0.0 em modo desenvolvimento (para testar em celulares na mesma rede)
# Valores: true ou false (padrão: false, apenas 127.0.0.1)
ALLOW_LAN_ACCESS=false

# Backend opcional de sessão em produção (ex: Redis no Render / Upstash)
# Se omitido, utiliza armazenamento no sistema de arquivos local (.flask_session/)
# REDIS_URL=redis://default:senha@host:porta
